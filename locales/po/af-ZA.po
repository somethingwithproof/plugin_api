#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Aktiveer REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Laat geverifieerde kliënte toe om toegang tot eindpunte onder /plugins/api/v1 te verkry."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Koerslimiet (Versoeke / Minuut)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Maksimum versoeke toegelaat per 60-sekonde-venster per teken of kliënt-IP."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Verstek teken-TTL (Dae)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Verstek vervaltydperk in dae vir nuutgeskepte toepassingswagwoorde (0 deaktiveer verstek vervaltyd)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "CORS-toegelate oorspronge"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Komma- of nuwereël-geskeide oorspronge wat toegelaat word om die API vanaf blaaiers te roep (moet nooit * saam met geloofsbriewe gebruik nie)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS Laat geloofsbriewe toe"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Stuur Access-Control-Allow-Credentials: true uit vir uitdruklik toegelate oorspronge (word geïgnoreer as oorsprong * is)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Vereis HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Wys nie-HTTPS API-versoeke af met 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Maksimum versoekliggaamgrootte (Grepe)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Boonste perk op HTTP-versoekdataladings wat deur die REST API aanvaar word (verstek 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Aktiveer YAML-inhoudsonderhandeling"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Laat kliënte wat Accept: application/yaml stuur toe om YAML-antwoorde te ontvang."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Behou toestandtabelle by deïnstallasie"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Behou plugin_api_tokens, plugin_api_operations, plugin_api_idempotency en plugin_api_rate_limits by deïnstallasie."

