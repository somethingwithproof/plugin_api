#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "REST API-ის ჩართვა"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "ავტორიზებული კლიენტებისთვის /plugins/api/v1 საბოლოო წერტილებზე წვდომის დაშვება."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "მოთხოვნების ლიმიტი (მოთხოვნა / წუთში)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "60-წამიან ინტერვალში დაშვებული მოთხოვნების მაქსიმალური რაოდენობა თითო ტოკენზე ან კლიენტის IP მისამართზე."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "ტოკენის ნაგულისხმევი TTL (დღეებში)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "ახლად შექმნილი აპლიკაციის პაროლების ვადის ამოწურვის ნაგულისხმევი პერიოდი დღეებში (0 გამორთავს ნაგულისხმევ ვადას)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "CORS დაშვებული წყაროები"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "მძიმით ან ახალი ხაზით გამოყოფილი წყაროები, რომლებსაც უფლება აქვთ ბრაუზერიდან მიმართონ API-ს (არასოდეს გამოიყენოთ * ავტორიზაციის მონაცემებთან ერთად)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS ავტორიზაციის მონაცემების დაშვება"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Access-Control-Allow-Credentials: true სათაურის გაგზავნა მკაფიოდ დაშვებული წყაროებისთვის (იგნორირდება, თუ წყარო არის *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "HTTPS-ის მოთხოვნა"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "არა-HTTPS API მოთხოვნების უარყოფა 400 FAILED_PRECONDITION შეცდომით."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "მოთხოვნის ტანის მაქსიმალური ზომა (ბაიტებში)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "REST API-ის მიერ მიღებული HTTP მოთხოვნის მონაცემების ზედა ზღვარი (ნაგულისხმევი 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "YAML კონტენტის შეთანხმების ჩართვა"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "კლიენტებისთვის, რომლებიც აგზავნიან Accept: application/yaml სათაურს, YAML პასუხების მიღების დაშვება."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "მდგომარეობის ცხრილების შენახვა დეინსტალაციისას"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "plugin_api_tokens, plugin_api_operations, plugin_api_idempotency და plugin_api_rate_limits ცხრილების შენახვა დეინსტალაციისას."

