#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Включить REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Разрешить аутентифицированным клиентам доступ к конечным точкам /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Ограничение частоты (запросов в минуту)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Максимальное число запросов за 60-секундный интервал на один токен или IP клиента."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL токена по умолчанию (дни)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Срок действия по умолчанию в днях для новых паролей приложений (0 отключает срок действия по умолчанию)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Разрешенные источники CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Разделенный запятыми или переводами строк список источников, которым разрешено вызывать API из браузеров (никогда не используйте * вместе с учетными данными)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Разрешить учетные данные CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Отправлять заголовок Access-Control-Allow-Credentials: true для явно разрешенных источников (игнорируется, если источник указан как *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Требовать HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Отклонять запросы к API без HTTPS с ошибкой 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Максимальный размер тела запроса (байты)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Верхний предел размера полезной нагрузки HTTP-запросов, принимаемых REST API (по умолчанию 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Включить согласование содержимого YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Разрешить клиентам, отправляющим заголовок Accept: application/yaml, получать ответы в формате YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Сохранять таблицы состояния при удалении"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Сохранять таблицы plugin_api_tokens, plugin_api_operations, plugin_api_idempotency и plugin_api_rate_limits при удалении плагина."

