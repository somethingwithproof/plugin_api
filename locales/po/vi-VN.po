#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Bật REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Cho phép các máy khách đã xác thực truy cập vào các điểm cuối /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Giới hạn tần suất (Yêu cầu / Phút)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Số yêu cầu tối đa được phép trong mỗi khoảng 60 giây cho từng token hoặc địa chỉ IP máy khách."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL token mặc định (Ngày)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Thời hạn hết hạn mặc định tính theo ngày cho mật khẩu ứng dụng mới tạo (0 để tắt thời hạn mặc định)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Nguồn gốc CORS được cho phép"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Danh sách nguồn gốc phân tách bằng dấu phẩy hoặc xuống dòng được phép gọi API từ trình duyệt (không bao giờ dùng * cùng với thông tin xác thực)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS cho phép thông tin xác thực"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Gửi tiêu đề Access-Control-Allow-Credentials: true cho các nguồn gốc được cho phép rõ ràng (bỏ qua nếu nguồn gốc là *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Yêu cầu HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Từ chối các yêu cầu API không dùng HTTPS bằng mã lỗi 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Kích thước thân yêu cầu tối đa (Byte)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Giới hạn trên đối với tải trọng yêu cầu HTTP mà REST API chấp nhận (mặc định 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Bật thương lượng nội dung YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Cho phép máy khách gửi Accept: application/yaml nhận phản hồi định dạng YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Giữ lại bảng trạng thái khi gỡ cài đặt"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Giữ nguyên các bảng plugin_api_tokens, plugin_api_operations, plugin_api_idempotency và plugin_api_rate_limits khi gỡ cài đặt."

