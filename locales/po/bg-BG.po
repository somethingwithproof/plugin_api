#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Активиране на REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Разрешава на удостоверени клиенти достъп до крайните точки на /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Ограничение на заявките (заявки / минута)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Максимален брой разрешени заявки за 60-секунден прозорец на токен или клиентски IP адрес."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL на токен по подразбиране (дни)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Срок на валидност по подразбиране в дни за новосъздадени пароли за приложения (0 деактивира срока по подразбиране)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Разрешени CORS източници"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Източници, разделени със запетая или нов ред, на които е разрешено да извикват API от браузъри (никога не използвайте * с удостоверителни данни)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Разрешаване на удостоверителни данни за CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Изпраща Access-Control-Allow-Credentials: true за изрично разрешени източници (игнорира се, ако източникът е *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Изискване на HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Отхвърля API заявки без HTTPS с код 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Макс. размер на тялото на заявката (байтове)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Горна граница за размера на HTTP заявките, приемани от REST API (по подразбиране 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Активиране на договаряне на YAML съдържание"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Позволява на клиенти, изпращащи Accept: application/yaml, да получават YAML отговори."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Запазване на таблиците за състояние при деинсталиране"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Запазва таблиците plugin_api_tokens, plugin_api_operations, plugin_api_idempotency и plugin_api_rate_limits при деинсталиране."

