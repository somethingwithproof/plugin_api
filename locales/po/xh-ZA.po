#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Vula i-REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Vumela abaxhasi abaqinisekisiweyo bafikelele kwiziphelo ze-/plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Umda weSantya (Izicelo / Umzuzu)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Elona nani liphezulu lezicelo ezivunyelweyo kwisithuba semizuzwana engama-60 ngethokheni nganye okanye nge-IP yomxhasi."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "I-TTL yeThokheni Emiselweyo (Iintsuku)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Ixesha elimiselweyo lokuphelelwa ngeentsuku lamagama okugqitha esicelo amatsha (u-0 uyacima ukuphelelwa okumiselweyo)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Imithombo EkuLuhlu Oluvunyelweyo lwe-CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Imithombo eyahlulwe ngekoma okanye ngomgca omtsha evunyelwe ukubiza i-API kwizikhangeli (ungaze usebenzise u-* kunye neziqinisekiso)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "I-CORS Vumela Iziqinisekiso"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Khupha i-Access-Control-Allow-Credentials: true kwimithombo ekuluhlu oluvunyelweyo ngokucacileyo (iyatyeshelwa ukuba umthombo ngu-*)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Funa i-HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Yala izicelo ze-API ezingeyiyo i-HTTPS nge-400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Elona Nani Liphezulu loBungakanani beSicelo (Iibhayithi)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Umda ophezulu wemithwalo yezicelo ze-HTTP eyamkelwa yi-REST API (okumiselweyo ngu-1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Vula Uthethathethwano loMxholo we-YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Vumela abaxhasi abathumela i-Accept: application/yaml bafumane iimpendulo ze-YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Gcina iiTheyibhile zeMo xa Kukhutshwa"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Gcina i-plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, kunye ne-plugin_api_rate_limits xa kukhutshwa isongezelelo."

