#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Iespējot REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Atļaut autentificētiem klientiem piekļūt /plugins/api/v1 galapunktiem."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Pieprasījumu ierobežojums (pieprasījumi minūtē)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Maksimālais atļautais pieprasījumu skaits 60 sekunžu periodā vienam marķierim vai klienta IP adresei."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Noklusējuma marķiera TTL (dienās)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Noklusējuma derīguma termiņš dienās jaunizveidotām lietotņu parolēm (0 atspējo noklusējuma derīguma termiņu)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "CORS atļautie avoti"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Ar komatu vai jaunu rindu atdalīti avoti, kuriem atļauts izsaukt API no pārlūkprogrammām (nekad neizmantojiet * kopā ar akreditācijas datiem)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS atļaut akreditācijas datus"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Nosūtīt galveni Access-Control-Allow-Credentials: true skaidri atļautajiem avotiem (tiek ignorēts, ja avots ir *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Pieprasīt HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Noraidīt ne-HTTPS API pieprasījumus ar kļūdu 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Maks. pieprasījuma pamatteksta lielums (baitos)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Augšējā robeža HTTP pieprasījumu datu apjomam, ko pieņem REST API (noklusējums 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Iespējot YAML satura saskaņošanu"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Atļaut klientiem, kas nosūta Accept: application/yaml, saņemt YAML atbildes."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Saglabāt stāvokļa tabulas atinstalēšanas laikā"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Atinstalējot saglabāt tabulas plugin_api_tokens, plugin_api_operations, plugin_api_idempotency un plugin_api_rate_limits."

