#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Omogući REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Dopusti autentificiranim klijentima pristup krajnjim točkama /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Ograničenje učestalosti (zahtjeva u minuti)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Najveći dopušteni broj zahtjeva u prozoru od 60 sekundi po tokenu ili IP adresi klijenta."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Zadani TTL tokena (dani)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Zadano razdoblje isteka u danima za novoizrađene aplikacijske lozinke (0 onemogućuje zadani istek)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Dopuštena CORS ishodišta"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Ishodišta odvojena zarezom ili novim retkom kojima je dopušteno pozivati API iz preglednika (nikada ne koristite * s vjerodajnicama)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS dopusti vjerodajnice"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Šalji zaglavlje Access-Control-Allow-Credentials: true za izričito dopuštena ishodišta (zanemaruje se ako je ishodište *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Zahtijevaj HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Odbij API zahtjeve koji ne koriste HTTPS s kodom 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Maksimalna veličina tijela zahtjeva (bajtovi)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Gornja granica veličine sadržaja HTTP zahtjeva koje REST API prihvaća (zadano 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Omogući pregovaranje YAML sadržaja"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Dopusti klijentima koji šalju Accept: application/yaml primanje YAML odgovora."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Zadrži tablice stanja pri deinstalaciji"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Sačuvaj tablice plugin_api_tokens, plugin_api_operations, plugin_api_idempotency i plugin_api_rate_limits pri deinstalaciji."

