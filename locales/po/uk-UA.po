#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Увімкнути REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Дозволити автентифікованим клієнтам доступ до кінцевих точок /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Обмеження частоти (запитів / хвилину)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Максимальна кількість запитів за 60-секундне вікно на один токен або IP клієнта."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL токена за замовчуванням (дні)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Термін дії в днях за замовчуванням для новостворених паролів застосунків (0 вимикає строк дії за замовчуванням)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Дозволені джерела CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Список джерел через кому або з нового рядка, яким дозволено викликати API з браузерів (ніколи не використовуйте * разом з обліковими даними)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Дозволити облікові дані CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Надсилати заголовок Access-Control-Allow-Credentials: true для явно дозволених джерел (ігнорується, якщо джерело - *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Вимагати HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Відхиляти запити API без HTTPS із кодом 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Максимальний розмір тіла запиту (байти)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Верхня межа корисного навантаження HTTP-запитів, що приймаються REST API (за замовчуванням 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Увімкнути узгодження вмісту YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Дозволити клієнтам, які надсилають Accept: application/yaml, отримувати відповіді у форматі YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Зберігати таблиці стану під час видалення"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Зберігати таблиці plugin_api_tokens, plugin_api_operations, plugin_api_idempotency та plugin_api_rate_limits під час видалення."

