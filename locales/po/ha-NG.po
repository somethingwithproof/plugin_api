#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Kunna REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Ba wa abokan hulɗa da aka tantance damar shiga wuraren haɗin /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Iyakar Yawan Buƙatu (Buƙatu / Minti)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Matsakaicin yawan buƙatun da aka yarda a kowane daƙiƙa 60 ga kowace alamar shiga ko adireshin IP na abokin hulɗa."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Tsohon TTL na Alamar Shiga (Kwanaki)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Tsohon lokacin ƙarewa a cikin kwanaki don sabbin Kalmomin Sirrin Manhaja da aka ƙirƙira (0 yana kashe tsohon lokacin ƙarewa)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Asalin Wuraren da Aka Ba Izini na CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Asalin wuraren da aka raba da waƙafi ko sabon layi waɗanda aka ba su izinin kiran API daga burauza (kada a taɓa amfani da * tare da bayanan shiga)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Ba da Izinin Bayanan Shiga na CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Fitar da Access-Control-Allow-Credentials: true ga asalin wuraren da aka ba izini kai tsaye (ana watsi da shi idan asalin shi ne *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Buƙaci HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Ƙi buƙatun API waɗanda ba na HTTPS ba tare da 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Matsakaicin Girman Jikin Buƙata (Baitoci)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Mafi girman adadin bayanan buƙatar HTTP da REST API ke karɓa (tsoho 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Kunna Tattaunawar Abun Ciki na YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Ba wa abokan hulɗa masu aika Accept: application/yaml damar karɓar amsoshin YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Ajiye Teburan Matsayi Lokacin Cire Manhaja"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Kiyaye teburan plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, da plugin_api_rate_limits lokacin cire manhaja."

