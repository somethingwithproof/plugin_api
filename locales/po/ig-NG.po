#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Kwado REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Kwe ka ngwa ahịa enyochara njirimara ha nweta isi njedebe /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Oke Arịrịọ (Arịrịọ / Nkeji)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Ọnụọgụ arịrịọ kasị elu akwadoro n'ime sekọnd 60 maka akara ma ọ bụ adreesị IP nke ngwa ahịa ọ bụla."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Oge TTL Akara Ndabara (Ụbọchị)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Oge ngwụcha ndabara n'ụbọchị maka Okwuntughe Ngwa emepụtara ọhụrụ (0 na-akwụsị oge ngwụcha ndabara)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Ebe Mbido Ekwadoro maka CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Ebe mbido ejiri rikọm ma ọ bụ ahịrị ọhụrụ kewaa nke ekwadoro ịkpọ API site n'ihe nchọgharị (ejila * yana nzere njirimara)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Kwe ka Nzere Njirimara CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Zipụ Access-Control-Allow-Credentials: true maka ebe mbido akwadoro kpọmkwem (a na-eleghara ya anya ma ọ bụrụ na ebe mbido bụ *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Chọọ HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Jụ arịrịọ API na-abụghị HTTPS jiri 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Oke Ibu Ahụ Arịrịọ Kasị Elu (Bayịtị)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Oke kasị elu maka ibu arịrịọ HTTP nke REST API na-anabata (ndabara 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Kwado Nkwekọrịta Ọdịnaya YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Kwe ka ngwa ahịa na-ezipụ Accept: application/yaml nata nzaghachi YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Debe Tebụl Ọnọdụ Mgbe A Na-ewepụ Ngwa Mgbakwunye"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Chekwaa plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, na plugin_api_rate_limits mgbe a na-ewepụ ngwa mgbakwunye."

