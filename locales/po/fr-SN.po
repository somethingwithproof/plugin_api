#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "REST API Google AIP"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Activer la REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Autoriser les clients authentifiés à accéder aux points de terminaison /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Limite de débit (requêtes / minute)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Nombre maximal de requêtes autorisées par fenêtre de 60 secondes par jeton ou adresse IP cliente."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL par défaut des jetons (jours)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Durée d'expiration par défaut en jours pour les nouveaux mots de passe d'application (0 désactive l'expiration par défaut)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Origines CORS autorisées"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Origines séparées par des virgules ou des sauts de ligne autorisées à appeler l'API depuis les navigateurs (n'utilisez jamais * avec des identifiants)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Autoriser les identifiants CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Émettre Access-Control-Allow-Credentials: true pour les origines explicitement autorisées (ignoré si l'origine est *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Exiger HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Rejeter les requêtes API non HTTPS avec 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Taille maximale du corps de requête (octets)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Limite supérieure des charges utiles de requêtes HTTP acceptées par la REST API (par défaut 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Activer la négociation de contenu YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Autoriser les clients envoyant Accept: application/yaml à recevoir des réponses YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Conserver les tables d'état lors de la désinstallation"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Conserver plugin_api_tokens, plugin_api_operations, plugin_api_idempotency et plugin_api_rate_limits lors de la désinstallation."

