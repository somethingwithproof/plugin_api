#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "REST API を有効にする"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "認証済みクライアントによる /plugins/api/v1 エンドポイントへのアクセスを許可します。"

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "レート制限 (リクエスト / 分)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "トークンまたはクライアント IP ごとに 60 秒間で許可される最大リクエスト数です。"

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "デフォルトのトークン TTL (日)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "新規作成されるアプリケーションパスワードのデフォルト有効期限 (日数) です (0 を指定するとデフォルトの有効期限を無効にします)。"

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "CORS 許可オリジン"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "ブラウザーから API を呼び出すことを許可するオリジンをカンマまたは改行区切りで指定します (認証情報とともに * を使用しないでください)。"

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS 認証情報の許可"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "明示的に許可リストへ登録されたオリジンに対して Access-Control-Allow-Credentials: true を出力します (オリジンが * の場合は無視されます)。"

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "HTTPS を必須にする"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "HTTPS 以外の API リクエストを 400 FAILED_PRECONDITION で拒否します。"

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "最大リクエストボディサイズ (バイト)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "REST API が受け付ける HTTP リクエストペイロードの上限です (デフォルト: 1048576 = 1 MiB)。"

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "YAML コンテンツネゴシエーションを有効にする"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Accept: application/yaml を送信するクライアントが YAML レスポンスを受信できるようにします。"

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "アンインストール時に状態テーブルを保持する"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "アンインストール時に plugin_api_tokens、plugin_api_operations、plugin_api_idempotency、および plugin_api_rate_limits を保持します。"

