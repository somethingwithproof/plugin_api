#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "تفعيل REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "السماح للعملاء المصادق عليهم بالوصول إلى نقاط النهاية /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "حد المعدل (طلب / دقيقة)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "الحد الأقصى للطلبات المسموح بها كل 60 ثانية لكل رمز أو عنوان IP للعميل."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "مدة صلاحية الرمز الافتراضية TTL (بالأيام)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "فترة انتهاء الصلاحية الافتراضية بالأيام لكلمات مرور التطبيقات المنشأة حديثاً (القيمة 0 تعطل انتهاء الصلاحية الافتراضي)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "المصادر المسموح بها لـ CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "المصادر المفصولة بفواصل أو أسطر جديدة المسموح لها باستدعاء API من المتصفحات (لا تستخدم * أبداً مع بيانات الاعتماد)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "السماح ببيانات الاعتماد في CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "إرسال ترويسة Access-Control-Allow-Credentials: true للمصادر المدرجة صراحةً في القائمة المسموح بها (يُتجاهل إذا كان المصدر *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "اشتراط HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "رفض طلبات API غير المستخدمة لبروتوكول HTTPS بالاستجابة 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "الحد الأقصى لحجم جسم الطلب (بالبايت)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "الحد الأعلى لحمولات طلبات HTTP المقبولة عبر REST API (الافتراضي 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "تفعيل التفاوض على محتوى YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "السماح للعملاء الذين يرسلون Accept: application/yaml بتلقي استجابات بتنسيق YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "الاحتفاظ بجداول الحالة عند إلغاء التثبيت"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "الاحتفاظ بجداول plugin_api_tokens و plugin_api_operations و plugin_api_idempotency و plugin_api_rate_limits عند إلغاء التثبيت."

