#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "REST API सक्षम करें"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "प्रमाणित क्लाइंट्स को /plugins/api/v1 एंडपॉइंट्स तक पहुँचने की अनुमति दें।"

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "दर सीमा (अनुरोध / मिनट)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "प्रति टोकन या क्लाइंट IP के लिए प्रत्येक 60-सेकंड की अवधि में अनुमत अधिकतम अनुरोध।"

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "डिफ़ॉल्ट टोकन TTL (दिन)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "नवनिर्मित एप्लिकेशन पासवर्ड के लिए दिनों में डिफ़ॉल्ट समाप्ति अवधि (0 डिफ़ॉल्ट समाप्ति को अक्षम करता है)।"

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "CORS अनुमति-सूचीबद्ध ऑरिजिन"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "ब्राउज़र से API को कॉल करने के लिए अनुमत अल्पविराम या नई पंक्ति से पृथक ऑरिजिन (क्रेडेंशियल्स के साथ कभी भी * का उपयोग न करें)।"

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS क्रेडेंशियल्स की अनुमति दें"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "स्पष्ट रूप से अनुमति-सूचीबद्ध ऑरिजिन के लिए Access-Control-Allow-Credentials: true भेजें (यदि ऑरिजिन * है तो अनदेखा किया जाता है)।"

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "HTTPS आवश्यक करें"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "गैर-HTTPS API अनुरोधों को 400 FAILED_PRECONDITION के साथ अस्वीकार करें।"

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "अधिकतम अनुरोध बॉडी आकार (बाइट्स)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "REST API द्वारा स्वीकार किए जाने वाले HTTP अनुरोध पेलोड की अधिकतम सीमा (डिफ़ॉल्ट 1048576 = 1 MiB)।"

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "YAML सामग्री समन्वय सक्षम करें"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Accept: application/yaml भेजने वाले क्लाइंट्स को YAML प्रतिक्रियाएँ प्राप्त करने की अनुमति दें।"

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "अनइंस्टॉल पर स्टेट तालिकाएँ सुरक्षित रखें"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "अनइंस्टॉल करने पर plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, और plugin_api_rate_limits को सुरक्षित रखें।"

