#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Alefa ny REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Avela hiditra amin'ny teboka /plugins/api/v1 ireo mpanjifa voamarina."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Fetran'ny Fangatahana (Fangatahana / Minitra)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Isan'ny fangatahana ambony indrindra ekena isaky ny 60 segondra ho an'ny mari-pamantarana na adiresy IP mpanjifa tsirairay."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL Mahazatra ho an'ny Mari-pamantarana (Andro)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Fe-potoana fahalaniana daty mahazatra amin'ny andro ho an'ny Teny Miafina Fampiharana vao noforonina (0 dia manafoana ny fahalaniana daty mahazatra)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Loharano CORS Ekena"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Loharano sarahin'ny faingo na andalana vaovao izay avela hiantso ny API avy amin'ny mpitety tranonkala (aza mampiasa * miaraka amin'ny fanamarinam-pananana mihitsy)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Avela ny Fanamarinam-pananana CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Mamoaka Access-Control-Allow-Credentials: true ho an'ireo loharano voasoratra mazava ao amin'ny lisitra ekena (tsy raharahaina raha * ny loharano)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Mitaky HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Lavina miaraka amin'ny 400 FAILED_PRECONDITION ireo fangatahana API tsy mampiasa HTTPS."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Haben'ny Votoatin'ny Fangatahana Ambony Indrindra (Oktety)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Fetra ambony ho an'ny votoatin'ny fangatahana HTTP eken'ny REST API (mahazatra 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Alefa ny Fifampiraharahana Votoaty YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Avela hahazo valiny YAML ireo mpanjifa mandefa Accept: application/yaml."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Tahirizina ny Tabilao Toetra Rehefa Esorina"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Tahirizina ny plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, ary plugin_api_rate_limits rehefa esorina."

