#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "REST API inschakelen"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Geef geauthenticeerde clients toegang tot eindpunten onder /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Snelheidslimiet (verzoeken / minuut)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Maximaal aantal toegestane verzoeken per tijdvak van 60 seconden per token of client-IP."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Standaard TTL voor tokens (dagen)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Standaard vervaltermijn in dagen voor nieuw aangemaakte applicatiewachtwoorden (0 schakelt standaard vervallen uit)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Toegestane CORS-herkomsten"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Door komma's of nieuwe regels gescheiden herkomsten die de API vanuit browsers mogen aanroepen (gebruik nooit * met inloggegevens)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS-inloggegevens toestaan"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Verstuur Access-Control-Allow-Credentials: true voor expliciet toegestane herkomsten (wordt genegeerd als de herkomst * is)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "HTTPS vereisen"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Wijs API-verzoeken zonder HTTPS af met 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Maximale grootte van verzoekinhoud (bytes)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Bovengrens voor HTTP-verzoekgegevens die door de REST API worden geaccepteerd (standaard 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "YAML-inhoudsonderhandeling inschakelen"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Sta clients die Accept: application/yaml verzenden toe om YAML-antwoorden te ontvangen."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Statustabellen behouden bij verwijderen"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Behoud plugin_api_tokens, plugin_api_operations, plugin_api_idempotency en plugin_api_rate_limits bij het verwijderen."

