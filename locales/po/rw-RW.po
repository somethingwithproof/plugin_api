#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Gukoresha REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Emerera abakiriya bemejwe kugera ku miyoboro ya /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Igipimo Ntarengwa (Ibisabwa / Umunota)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Umubare ntarengwa w'ibisabwa byemewe mu masegonda 60 kuri buri kimenyetso cyangwa aderesi IP y'umukiriya."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL Mbanziriza y'Ikimenyetso (Iminsi)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Igihe mbanziriza mu minsi cyo kurangira kw'Amagambo y'Ibanga ya Porogaramu mashya yaremwe (0 ihagarika irangira mbanziriza)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Inkomoko Zemewe za CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Inkomoko zitandukanyijwe n'ikitso cyangwa umurongo mushya zemewe guhamagara API zivuye muri mushakisha (ntukigere ukoresha * hamwe n'ibimenyetso by'uburenganzira)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Kwemerera Ibimenyetso by'Uburenganzira muri CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Kohereza Access-Control-Allow-Credentials: true ku nkomoko zashyizwe ku rutonde rwemewe ku buryo busobanutse (ntibyitabwaho iyo inkomoko ari *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Gusaba HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Kwanga ibisabwa bya API bidakoresha HTTPS ukoresheje 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Ingano Ntarengwa y'Igice cy'Igisabwa (Bayite)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Igipimo ntarengwa cy'amakuru yoherezwa mu bisabwa bya HTTP byemerwa na REST API (mbanziriza ni 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Gukoresha Igenwa ry'Imiterere ya YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Emerera abakiriya bohereza Accept: application/yaml kwakira ibisubizo biri muri YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Gukomeza Kubika Imbonerahamwe z'Imiterere mu gihe cyo Kuvanaho"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Gukomeza kubika plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, na plugin_api_rate_limits mu gihe cyo kuvanaho."

