#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "REST API Google AIP"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Habilitar REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Permitir que clientes autenticados acessem os endpoints de /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Limite de taxa (requisições / minuto)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Número máximo de requisições permitidas por janela de 60 segundos por token ou IP do cliente."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL padrão do token (dias)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Período padrão de expiração em dias para novas senhas de aplicativo criadas (0 desabilita a expiração padrão)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Origens CORS permitidas"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Origens separadas por vírgula ou quebra de linha com permissão para chamar a API a partir de navegadores (nunca use * com credenciais)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Permitir credenciais CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Enviar Access-Control-Allow-Credentials: true para origens explicitamente permitidas (ignorado se a origem for *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Exigir HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Rejeitar requisições de API que não usem HTTPS com 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Tamanho máximo do corpo da requisição (bytes)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Limite máximo para cargas úteis de requisições HTTP aceitas pela REST API (padrão 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Habilitar negociação de conteúdo YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Permitir que clientes que enviam Accept: application/yaml recebam respostas em YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Manter tabelas de estado ao desinstalar"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Preservar plugin_api_tokens, plugin_api_operations, plugin_api_idempotency e plugin_api_rate_limits ao desinstalar."

