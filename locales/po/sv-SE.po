#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Aktivera REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Tillåt autentiserade klienter att komma åt slutpunkter under /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Hastighetsgräns (begäranden / minut)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Högsta antal tillåtna begäranden per 60-sekundersfönster per token eller klient-IP."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Standard-TTL för token (dagar)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Standardgiltighetstid i dagar för nyskapade applikationslösenord (0 inaktiverar standardutgång)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Tillåtna CORS-ursprung"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Komma- eller radbrytningsseparerade ursprung som tillåts anropa API:et från webbläsare (använd aldrig * med inloggningsuppgifter)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Tillåt inloggningsuppgifter i CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Skicka Access-Control-Allow-Credentials: true för uttryckligen tillåtna ursprung (ignoreras om ursprunget är *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Kräv HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Avvisa API-begäranden utan HTTPS med 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Maximal storlek på begärandekropp (byte)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Övre gräns för nyttolast i HTTP-begäranden som accepteras av REST API (standard 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Aktivera YAML-innehållsförhandling"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Tillåt klienter som skickar Accept: application/yaml att ta emot YAML-svar."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Behåll tillståndstabeller vid avinstallation"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Behåll plugin_api_tokens, plugin_api_operations, plugin_api_idempotency och plugin_api_rate_limits vid avinstallation."

