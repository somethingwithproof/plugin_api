#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Mú REST API ṣiṣẹ́"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Fún àwọn olùbéèrè tí a fìdí wọn múlẹ̀ láyè láti wọ àwọn ibùdó ìsopọ̀ /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Ààlà Ìbéèrè (Àwọn ìbéèrè / Ìṣẹ́jú)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Iye ìbéèrè tí ó pọ̀ jù lọ tí a gbà láyè láàárín ìṣẹ́jú-àáyá 60 fún tókènì kọ̀ọ̀kan tàbí IP olùbéèrè."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL Tókènì Àtìpìlẹ̀ (Àwọn Ọjọ́)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Àkókò ìparí àtìpìlẹ̀ ní ọjọ́ fún Àwọn Ọ̀rọ̀ Aṣínà Ohun Èlò tuntun tí a ṣẹ̀dá (0 máa ń pa ìparí àtìpìlẹ̀ tì)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Àwọn Orísun CORS Tí A Fọwọ́sí"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Àwọn orísun tí a fi kọ́mà tàbí ìlà tuntun pín tí a gbà láyè láti pe API láti inú àwọn àṣàwákiri (má ṣe lo * pẹ̀lú ẹ̀rí ìwọlé láéláé)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Gba Ẹ̀rí Ìwọlé CORS Láyè"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Fi Access-Control-Allow-Credentials: true ránṣẹ́ fún àwọn orísun tí a fọwọ́sí ní pàtó (a máa ń fojú fò ó bí orísun bá jẹ́ *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Nílò HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Kọ àwọn ìbéèrè API tí kì í ṣe HTTPS pẹ̀lú 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Ìwọ̀n Ara Ìbéèrè Tí Ó Pọ̀ Jù (Báìtì)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Ààlà òkè lórí àkóónú dátà ìbéèrè HTTP tí REST API ń gbà (àtìpìlẹ̀ 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Mú Ìjíròrò Àkóónú YAML Ṣiṣẹ́"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Fún àwọn olùbéèrè tí ń fi Accept: application/yaml ránṣẹ́ láyè láti gba ìdáhùn YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Pa Àwọn Tábìlì Ipò Mọ́ Nígbà Ìyọkúrò"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Pa plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, àti plugin_api_rate_limits mọ́ nígbà tí a bá yọ àfikún kúrò."

