#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Hawl-geli REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "U oggolow macaamiisha la xaqiijiyay inay galaan baraha dhammaadka /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Xadka Heerka Codsiyada (Codsiyo / Daqiiqad)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Tirada ugu badan ee codsiyada la oggol yahay 60-kii ilbiriqsiba halkii calaamad ama cinwaan IP ee macmiilka."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL-ka Caadiga ah ee Calaamadda (Maalmo)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Muddada dhicitaanka caadiga ah ee maalmaha loogu talagalay Furayaasha Sirta ah ee Barnaamijka ee cusub (0 waxay damisaa dhicitaanka caadiga ah)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Ilaha Liiska Oggolaanshaha CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Ilo ay kala soocayaan hakad ama sadar cusub oo loo oggol yahay inay ka wacaan API baraawsarrada (marnaba ha u isticmaalin * aqoonsiyo gelitaan)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Oggolow Aqoonsiyada CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Soo saar Access-Control-Allow-Credentials: true ilaha si cad ugu jira liiska oggolaanshaha (waa la iska indho-tiraa haddii isha ay tahay *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Waajib ka dhig HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Ku diid codsiyada API ee aan HTTPS ahayn 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Cabbirka Ugu Badan ee Jirka Codsiga (Bayt)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Xadka ugu sarreeya ee xamuulka codsiyada HTTP ee uu aqbalo REST API (caadiga ah 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Hawl-geli Wada-xaajoodka Nuxurka YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "U oggolow macaamiisha soo diraya Accept: application/yaml inay helaan jawaabo YAML ah."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Hay Jadwallada Xaaladda Marka la Tirtiro"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Xafid jadwallada plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, iyo plugin_api_rate_limits marka la tirtiro."

