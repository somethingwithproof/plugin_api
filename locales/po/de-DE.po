#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "REST API aktivieren"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Authentifizierten Clients den Zugriff auf Endpunkte unter /plugins/api/v1 erlauben."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Ratenbegrenzung (Anfragen / Minute)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Maximal zulässige Anfragen pro 60-Sekunden-Zeitfenster pro Token oder Client-IP."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Standard-Token-TTL (Tage)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Standardmäßige Gültigkeitsdauer in Tagen für neu erstellte Anwendungspasswörter (0 deaktiviert den Standardablauf)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Zugelassene CORS-Ursprünge"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Durch Kommas oder Zeilenumbrüche getrennte Ursprünge, die die API aus Browsern aufrufen dürfen (niemals * zusammen mit Anmeldedaten verwenden)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS-Anmeldedaten zulassen"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Sendet Access-Control-Allow-Credentials: true für ausdrücklich zugelassene Ursprünge (wird ignoriert, wenn der Ursprung * ist)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "HTTPS erzwingen"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "API-Anfragen ohne HTTPS mit 400 FAILED_PRECONDITION ablehnen."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Maximale Größe der Anfragenutzdaten (Bytes)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Obergrenze für HTTP-Anfragenutzdaten, die von der REST API akzeptiert werden (Standard: 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "YAML-Inhaltsaushandlung aktivieren"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Clients, die Accept: application/yaml senden, den Empfang von YAML-Antworten ermöglichen."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Zustandstabellen bei Deinstallation behalten"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Die Tabellen plugin_api_tokens, plugin_api_operations, plugin_api_idempotency und plugin_api_rate_limits bei der Deinstallation beibehalten."

