#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Abilita REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Consenti ai client autenticati di accedere agli endpoint /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Limite di frequenza (Richieste / Minuto)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Numero massimo di richieste consentite per finestra di 60 secondi per token o IP del client."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL predefinito del token (Giorni)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Periodo di scadenza predefinito in giorni per le nuove password applicative (0 disabilita la scadenza predefinita)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Origini CORS consentite"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Origini separate da virgole o nuove righe autorizzate a chiamare l'API dai browser (non usare mai * con le credenziali)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Consenti credenziali CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Invia Access-Control-Allow-Credentials: true per le origini esplicitamente consentite (ignorato se l'origine è *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Richiedi HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Rifiuta le richieste API non HTTPS con 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Dimensione massima del corpo della richiesta (Byte)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Limite massimo per il payload delle richieste HTTP accettato dalla REST API (predefinito 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Abilita negoziazione dei contenuti YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Consenti ai client che inviano Accept: application/yaml di ricevere risposte YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Mantieni le tabelle di stato alla disinstallazione"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Conserva plugin_api_tokens, plugin_api_operations, plugin_api_idempotency e plugin_api_rate_limits alla disinstallazione."

