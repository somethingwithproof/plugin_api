#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Wezesha REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Ruhusu wateja waliothibitishwa kufikia ncha za mwisho za /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Kikomo cha Kasi (Maombi / Dakika)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Idadi ya juu ya maombi yanayoruhusiwa kwa kila kipindi cha sekunde 60 kwa kila tokeni au anwani ya IP ya mteja."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL Chaguo-msingi ya Tokeni (Siku)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Muda chaguo-msingi wa kuisha kwa siku kwa Manenosiri ya Programu yaliyoundwa hivi karibuni (0 huzima muda chaguo-msingi wa kuisha)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Vyanzo Vilivyoruhusiwa vya CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Vyanzo vilivyotenganishwa kwa koma au mstari mpya vinavyoruhusiwa kuita API kutoka kwa vivinjari (usitumie * kamwe pamoja na vitambulisho)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Ruhusu Vitambulisho vya CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Tuma Access-Control-Allow-Credentials: true kwa vyanzo vilivyoruhusiwa waziwazi (hupuuzwa ikiwa chanzo ni *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Hitaji HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Kataa maombi ya API yasiyo ya HTTPS kwa msimbo wa 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Ukubwa wa Juu wa Mwili wa Ombi (Baiti)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Kikomo cha juu cha mizigo ya data ya maombi ya HTTP inayokubaliwa na REST API (chaguo-msingi 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Wezesha Majadiliano ya Maudhui ya YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Ruhusu wateja wanaotuma Accept: application/yaml kupokea majibu ya YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Hifadhi Majedwali ya Hali Wakati wa Kuondoa"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Hifadhi majedwali ya plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, na plugin_api_rate_limits wakati wa kuondoa programu-jalizi."

