#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Омогући REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Дозволи аутентификованим клијентима приступ крајњим тачкама /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Ограничење броја захтева (захтева / минут)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Максималан дозвољени број захтева у интервалу од 60 секунди по токену или IP адреси клијента."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Подразумевани TTL токена (дани)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Подразумевани рок важења у данима за новокреиране лозинке апликација (0 онемогућава подразумевано истицање)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Дозвољена CORS порекла"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Порекла одвојена зарезом или новим редом којима је дозвољено да позивају API из прегледача (никада не користите * са акредитивима)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Дозволи CORS акредитиве"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Шаљи Access-Control-Allow-Credentials: true за изричито дозвољена порекла (игнорише се ако је порекло *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Захтевај HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Одбиј API захтеве који не користе HTTPS одговором 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Максимална величина тела захтева (бајтови)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Горња граница величине садржаја HTTP захтева које REST API прихвата (подразумевано 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Омогући преговарање о YAML садржају"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Дозволи клијентима који шаљу Accept: application/yaml да примају YAML одговоре."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Задржи табеле стања при деинсталацији"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Сачувај табеле plugin_api_tokens, plugin_api_operations, plugin_api_idempotency и plugin_api_rate_limits при деинсталацији."

