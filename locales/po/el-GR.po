#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Ενεργοποίηση REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Επιτρέψτε σε πιστοποιημένους πελάτες να έχουν πρόσβαση στα τελικά σημεία /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Όριο ρυθμού (Αιτήματα / Λεπτό)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Μέγιστος επιτρεπόμενος αριθμός αιτημάτων ανά παράθυρο 60 δευτερολέπτων ανά διακριτικό ή διεύθυνση IP πελάτη."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Προεπιλεγμένο TTL διακριτικού (Ημέρες)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Προεπιλεγμένη περίοδος λήξης σε ημέρες για νέους κωδικούς εφαρμογής (το 0 απενεργοποιεί την προεπιλεγμένη λήξη)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Επιτρεπόμενες προελεύσεις CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Προελεύσεις διαχωρισμένες με κόμμα ή νέα γραμμή που επιτρέπεται να καλούν το API από προγράμματα περιήγησης (μη χρησιμοποιείτε ποτέ * με διαπιστευτήρια)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Αποδοχή διαπιστευτηρίων CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Αποστολή Access-Control-Allow-Credentials: true για ρητά επιτρεπόμενες προελεύσεις (αγνοείται αν η προέλευση είναι *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Απαίτηση HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Απόρριψη αιτημάτων API χωρίς HTTPS με 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Μέγιστο μέγεθος σώματος αιτήματος (byte)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Ανώτατο όριο για το φορτίο αιτημάτων HTTP που δέχεται το REST API (προεπιλογή 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Ενεργοποίηση διαπραγμάτευσης περιεχομένου YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Επιτρέψτε σε πελάτες που στέλνουν Accept: application/yaml να λαμβάνουν αποκρίσεις YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Διατήρηση πινάκων κατάστασης κατά την απεγκατάσταση"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Διατήρηση των πινάκων plugin_api_tokens, plugin_api_operations, plugin_api_idempotency και plugin_api_rate_limits κατά την απεγκατάσταση."

