#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Włącz REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Zezwól uwierzytelnionym klientom na dostęp do punktów końcowych /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Limit zapytań (zapytania / minutę)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Maksymalna dozwolona liczba zapytań w 60-sekundowym oknie na token lub adres IP klienta."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Domyślny TTL tokenu (dni)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Domyślny okres ważności w dniach dla nowo utworzonych haseł aplikacji (0 wyłącza domyślne wygasanie)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Dozwolone źródła CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Oddzielone przecinkami lub nowymi liniami źródła uprawnione do wywoływania API z przeglądarek (nigdy nie używaj * z poświadczeniami)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Zezwalaj na poświadczenia CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Wysyłaj nagłówek Access-Control-Allow-Credentials: true dla jawnie dozwolonych źródeł (ignorowane, gdy źródłem jest *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Wymagaj HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Odrzucaj zapytania API bez HTTPS kodem 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Maksymalny rozmiar treści żądania (bajty)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Górny limit rozmiaru danych żądań HTTP akceptowanych przez REST API (domyślnie 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Włącz negocjację treści YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Zezwól klientom wysyłającym nagłówek Accept: application/yaml na otrzymywanie odpowiedzi w formacie YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Zachowaj tabele stanu przy odinstalowaniu"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Zachowaj tabele plugin_api_tokens, plugin_api_operations, plugin_api_idempotency oraz plugin_api_rate_limits podczas odinstalowywania."

