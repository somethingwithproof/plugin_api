#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Ativar REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Permitir que clientes autenticados acedam aos endpoints /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Limite de taxa (pedidos / minuto)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Número máximo de pedidos permitidos por janela de 60 segundos por token ou IP do cliente."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL predefinido do token (dias)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Período de expiração predefinido em dias para palavras-passe de aplicação recém-criadas (0 desativa a expiração predefinida)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Origens CORS na lista de permissões"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Origens separadas por vírgulas ou quebras de linha autorizadas a invocar a API a partir de navegadores (nunca utilize * com credenciais)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Permitir credenciais CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Emitir Access-Control-Allow-Credentials: true para origens explicitamente incluídas na lista de permissões (ignorado se a origem for *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Exigir HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Rejeitar pedidos da API sem HTTPS com 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Tamanho máximo do corpo do pedido (bytes)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Limite máximo para o conteúdo útil de pedidos HTTP aceites pela REST API (predefinição 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Ativar negociação de conteúdo YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Permitir que clientes que enviem Accept: application/yaml recebam respostas YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Manter tabelas de estado ao desinstalar"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Preservar plugin_api_tokens, plugin_api_operations, plugin_api_idempotency e plugin_api_rate_limits ao desinstalar."

