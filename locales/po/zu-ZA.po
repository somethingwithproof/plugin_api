#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Nika Amandla i-REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Vumela amaklayenti aqinisekisiwe ukuthi afinyelele ezindaweni zokuxhumana ezithi /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Umkhawulo Wezinga (Izicelo / Ngomzuzu)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Inani eliphezulu lezicelo ezivunyelwe esikhathini esiyimizuzwana engu-60 ngethokheni ngayinye noma nge-IP yeklayenti."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "I-TTL Yethokheni Ezenzakalelayo (Izinsuku)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Isikhathi esizenzakalelayo sokuphelelwa yisikhathi ngezinsuku samaphasiwedi ohlelo lokusebenza asanda kudalwa (u-0 ukhubaza ukuphelelwa yisikhathi okuzenzakalelayo)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Imithombo Evunyelwe Ohlwini lwe-CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Imithombo ehlukaniswe ngokhefana noma ngomugqa omusha evunyelwe ukubiza i-API kusuka kuziphequluli (ungalokothi usebenzise u-* nezifakazo)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "I-CORS Ivumela Izifakazo"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Thumela unhlokweni othi Access-Control-Allow-Credentials: true emithonjeni evunyelwe ngokucacile ohlwini (kuyashaywa indiva uma umthombo ungu-*)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Funa i-HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Yenqaba izicelo ze-API ezingeyona i-HTTPS ngephutha elithi 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Usayizi Ophezulu Womzimba Wesicelo (Amabhayithi)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Umkhawulo ophezulu wemithwalo yedatha yezicelo ze-HTTP ezamukelwa yi-REST API (okuzenzakalelayo ngu-1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Nika Amandla Ukuxoxisana Kokuqukethwe kwe-YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Vumela amaklayenti athumela unhlokweni othi Accept: application/yaml ukuthi athole izimpendulo ze-YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Gcina Amathebula Esimo Lapho Ukhipha"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Gcina amathebula athi plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, kanye nelithi plugin_api_rate_limits lapho ukhipha isengezo."

