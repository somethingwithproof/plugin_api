#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "REST API አንቃ"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "የተረጋገጡ ደንበኞች የ /plugins/api/v1 መድረሻ ነጥቦችን እንዲጠቀሙ ፍቀድ።"

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "የፍጥነት ገደብ (ጥያቄዎች / ደቂቃ)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "በአንድ ቶክን ወይም የደንበኛ IP በ60 ሰከንድ ጊዜ ውስጥ የሚፈቀዱ ከፍተኛ ጥያቄዎች።"

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "ነባሪ የቶክን TTL (ቀናት)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "ለአዲስ የተፈጠሩ የመተግበሪያ የይለፍ ቃላት ነባሪ የማለቂያ ጊዜ በቀናት (0 ነባሪውን የማለቂያ ጊዜ ያሰናክላል)።"

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "የ CORS የተፈቀዱ መነሻዎች"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "ከአሳሾች API ለመጥራት የተፈቀዱ በኮማ ወይም በአዲስ መስመር የተለዩ መነሻዎች (* ከማረጋገጫዎች ጋር በጭራሽ አይጠቀሙ)።"

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS ማረጋገጫዎችን ፍቀድ"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "በግልጽ ለተፈቀዱ መነሻዎች Access-Control-Allow-Credentials: true ላክ (መነሻው * ከሆነ ችላ ይባላል)።"

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "HTTPS አስገድድ"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "HTTPS ያልሆኑ የ API ጥያቄዎችን በ 400 FAILED_PRECONDITION ውድቅ አድርግ።"

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "ከፍተኛ የጥያቄ አካል መጠን (ባይቶች)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "በ REST API የሚቀበሉ የ HTTP ጥያቄ ጭነቶች ከፍተኛ ገደብ (ነባሪ 1048576 = 1 MiB)።"

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "የ YAML ይዘት ድርድር አንቃ"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Accept: application/yaml የሚልኩ ደንበኞች የ YAML ምላሾችን እንዲቀበሉ ፍቀድ።"

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "ሲራገፍ የሁኔታ ሰንጠረዦችን አቆይ"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "ሲራገፍ plugin_api_tokens፣ plugin_api_operations፣ plugin_api_idempotency እና plugin_api_rate_limits ሰንጠረዦችን አቆይ።"

