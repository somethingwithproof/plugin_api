#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "REST API'yi Etkinleştir"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Kimliği doğrulanmış istemcilerin /plugins/api/v1 uç noktalarına erişmesine izin ver."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Hız Sınırı (İstek / Dakika)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Belirteç veya istemci IP adresi başına 60 saniyelik pencerede izin verilen en fazla istek sayısı."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "Varsayılan Belirteç TTL (Gün)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Yeni oluşturulan Uygulama Parolaları için gün cinsinden varsayılan geçerlilik süresi (0 varsayılan süre sonunu devre dışı bırakır)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "CORS İzin Verilen Kaynaklar"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Tarayıcılardan API çağrısı yapmasına izin verilen, virgül veya yeni satırla ayrılmış kaynaklar (kimlik bilgileriyle asla * kullanmayın)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "CORS Kimlik Bilgilerine İzin Ver"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Açıkça izin listesine eklenmiş kaynaklar için Access-Control-Allow-Credentials: true başlığını gönder (kaynak * ise yoksayılır)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "HTTPS Gerektir"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "HTTPS olmayan API isteklerini 400 FAILED_PRECONDITION ile reddet."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "En Fazla İstek Gövdesi Boyutu (Bayt)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "REST API tarafından kabul edilen HTTP istek yükleri için üst sınır (varsayılan 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "YAML İçerik Uzlaşmasını Etkinleştir"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Accept: application/yaml gönderen istemcilerin YAML yanıtları almasına izin ver."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Kaldırırken Durum Tablolarını Koru"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Kaldırma sırasında plugin_api_tokens, plugin_api_operations, plugin_api_idempotency ve plugin_api_rate_limits tablolarını koru."

