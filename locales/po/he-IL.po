#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "Google AIP REST API"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "הפעל REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "אפשר ללקוחות מאומתים לגשת לנקודות הקצה של /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "הגבלת קצב (בקשות לדקה)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "מספר הבקשות המרבי המותר בחלון של 60 שניות לכל אסימון או כתובת IP של לקוח."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL ברירת מחדל לאסימון (ימים)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "תקופת תפוגה כברירת מחדל בימים עבור סיסמאות יישום חדשות שנוצרו (0 מבטל תפוגת ברירת מחדל)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "מקורות CORS מאושרים"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "מקורות מופרדים בפסיקים או בשורות חדשות המורשים לקרוא ל-API מדפדפנים (לעולם אל תשתמש ב-* יחד עם פרטי אימות)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "אפשר פרטי אימות ב-CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "שלח Access-Control-Allow-Credentials: true עבור מקורות מאושרים במפורש (מתעלם אם המקור הוא *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "דרוש HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "דחה בקשות API שאינן HTTPS עם השגיאה 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "גודל מרבי לגוף בקשה (בתים)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "גבול עליון למטען של בקשות HTTP המתקבלות על ידי ה-REST API (ברירת מחדל 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "הפעל משא ומתן על תוכן YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "אפשר ללקוחות השולחים Accept: application/yaml לקבל תגובות YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "שמור טבלאות מצב בעת הסרת ההתקנה"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "שמור את הטבלאות plugin_api_tokens, plugin_api_operations, plugin_api_idempotency ו-plugin_api_rate_limits בעת הסרת ההתקנה."

