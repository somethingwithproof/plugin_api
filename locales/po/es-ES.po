#: lib/Settings.php setup.php
msgid "Google AIP REST API"
msgstr "REST API Google AIP"

#: lib/Settings.php
msgid "Enable REST API"
msgstr "Habilitar REST API"

#: lib/Settings.php
msgid "Allow authenticated clients to access /plugins/api/v1 endpoints."
msgstr "Permitir que los clientes autenticados accedan a los puntos de conexión de /plugins/api/v1."

#: lib/Settings.php
msgid "Rate Limit (Requests / Minute)"
msgstr "Límite de tasa (solicitudes / minuto)"

#: lib/Settings.php
msgid "Maximum requests allowed per 60-second window per token or client IP."
msgstr "Número máximo de solicitudes permitidas por ventana de 60 segundos por token o IP de cliente."

#: lib/Settings.php
msgid "Default Token TTL (Days)"
msgstr "TTL predeterminado del token (días)"

#: lib/Settings.php
msgid "Default expiration period in days for newly created Application Passwords (0 disables default expiry)."
msgstr "Periodo de caducidad predeterminado en días para las contraseñas de aplicación recién creadas (0 deshabilita la caducidad predeterminada)."

#: lib/Settings.php
msgid "CORS Allowlisted Origins"
msgstr "Orígenes permitidos por CORS"

#: lib/Settings.php
msgid "Comma- or newline-separated origins permitted to call the API from browsers (never use * with credentials)."
msgstr "Orígenes separados por comas o saltos de línea con permiso para invocar la API desde navegadores (no use nunca * con credenciales)."

#: lib/Settings.php
msgid "CORS Allow Credentials"
msgstr "Permitir credenciales en CORS"

#: lib/Settings.php
msgid "Emit Access-Control-Allow-Credentials: true for explicitly allowlisted origins (ignored if origin is *)."
msgstr "Emitir Access-Control-Allow-Credentials: true para orígenes incluidos explícitamente en la lista de permitidos (se ignora si el origen es *)."

#: lib/Settings.php
msgid "Require HTTPS"
msgstr "Requerir HTTPS"

#: lib/Settings.php
msgid "Reject non-HTTPS API requests with 400 FAILED_PRECONDITION."
msgstr "Rechazar las solicitudes de API que no usen HTTPS con 400 FAILED_PRECONDITION."

#: lib/Settings.php
msgid "Max Request Body Size (Bytes)"
msgstr "Tamaño máximo del cuerpo de solicitud (bytes)"

#: lib/Settings.php
msgid "Upper bound on HTTP request payloads accepted by the REST API (default 1048576 = 1 MiB)."
msgstr "Límite superior de las cargas útiles de solicitudes HTTP aceptadas por la REST API (predeterminado: 1048576 = 1 MiB)."

#: lib/Settings.php
msgid "Enable YAML Content Negotiation"
msgstr "Habilitar negociación de contenido YAML"

#: lib/Settings.php
msgid "Allow clients sending Accept: application/yaml to receive YAML responses."
msgstr "Permitir que los clientes que envíen Accept: application/yaml reciban respuestas YAML."

#: lib/Settings.php
msgid "Keep State Tables on Uninstall"
msgstr "Conservar tablas de estado al desinstalar"

#: lib/Settings.php
msgid "Preserve plugin_api_tokens, plugin_api_operations, plugin_api_idempotency, and plugin_api_rate_limits on uninstall."
msgstr "Conservar plugin_api_tokens, plugin_api_operations, plugin_api_idempotency y plugin_api_rate_limits al desinstalar."

